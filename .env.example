# Local development only. For production use scripts/configure.py.
APP_ENV=development
APP_ORIGIN=http://localhost:8080
APP_ADDRESS=http://:8080
SETUP_KEY=development-change-this-setup-key
# Empty for local/LAN. Production: public IP forwarded to the SFU host.
MEDIA_PUBLIC_IP=
MEDIA_UDP_MIN=50000
MEDIA_UDP_MAX=51999
# JSON, single-quoted for shell compatibility. Optional external STUN/TURN.
MEDIA_ICE_SERVERS='[]'
# Example authenticated TURN (configure matching coturn credentials):
#MEDIA_ICE_SERVERS='[{"urls":["stun:turn.example.com:3478","turn:turn.example.com:3478?transport=udp","turns:turn.example.com:5349?transport=tcp"],"username":"subdisc","credential":"replace-with-random-password"}]'
#TURN_DOMAIN=turn.example.com
#TURN_USER=subdisc
#TURN_PASSWORD=
#COMPOSE_PROFILES=duckdns
#DUCKDNS_DOMAIN=
#DUCKDNS_TOKEN=

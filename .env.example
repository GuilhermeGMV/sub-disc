# Desenvolvimento local SOMENTE. Em produção use scripts/configure.py.
APP_ENV=development
APP_ORIGIN=http://localhost:8080
APP_ADDRESS=http://:8080
MEDIA_ADDRESS=http://:7880
SETUP_KEY=development-change-this-setup-key
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=subdisc
LIVEKIT_API_SECRET=development-change-this-livekit-secret
# IP anunciado pelo SFU. Em produção use o IPv4 público real.
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_LOOPBACK=true
# TURN/UDP integrado opcional. TURN/TLS: docs/deployment.md.
TURN_ENABLED=false
TURN_DOMAIN=
